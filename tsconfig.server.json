{
    "compilerOptions": {
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.server.tsbuildinfo",
        "target": "es2023",
        "lib": ["ES2023"],
        "types": ["node"],
        "module": "esnext",
        "moduleResolution": "bundler",
        "skipLibCheck": true,
        "noEmit": true,
        "strict": true,
        "verbatimModuleSyntax": true,
        "noUnusedLocals": true,
        "erasableSyntaxOnly": true
    },
    "include": ["server", "shared"]
}